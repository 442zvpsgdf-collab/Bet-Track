# Conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bettrack_mx"

# NextAuth
# Genera un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-esto-con-un-secreto-generado"
