// Prisma schema — BetTrack MX
// Base de datos: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
}

enum BankrollTxType {
  DEPOSIT
  WITHDRAWAL
  BONUS
  ADJUSTMENT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  currency      String    @default("MXN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bets                Bet[]
  bankrollTransactions BankrollTransaction[]
  limits              UserLimits?
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Catálogo de casas de apuestas. Empieza con las 5 iniciales (seed)
// pero está diseñado para agregar más sin tocar código (admin panel futuro).
model Sportsbook {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  // Campo reservado para integraciones oficiales futuras (API key config, etc.)
  // No se usa en el MVP — ver sección "Integraciones futuras" en README.
  apiIntegrationConfig Json?
  createdAt DateTime @default(now())

  bets Bet[]

  @@map("sportsbooks")
}

model Sport {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)

  leagues League[]
  bets    Bet[]

  @@map("sports")
}

model League {
  id        String   @id @default(cuid())
  name      String
  sportId   String
  sport     Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)

  bets Bet[]

  @@unique([name, sportId])
  @@index([sportId])
  @@map("leagues")
}

enum BetType {
  MONEYLINE
  SPREAD
  OVER_UNDER
  PARLAY
  PROP
  FUTURES
  OTHER
}

model Bet {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  sportsbookId  String
  sportsbook    Sportsbook @relation(fields: [sportsbookId], references: [id])

  sportId       String
  sport         Sport      @relation(fields: [sportId], references: [id])

  leagueId      String?
  league        League?    @relation(fields: [leagueId], references: [id])

  event         String     // ej. "Broncos vs Chiefs"
  betType       BetType
  selection     String     // ej. "Broncos +3.5"

  odds          Decimal    @db.Decimal(10, 3) // cuota decimal, ej 1.900
  stake         Decimal    @db.Decimal(12, 2) // monto apostado
  currency      String     @default("MXN")

  status        BetStatus  @default(PENDING)
  profit        Decimal    @db.Decimal(12, 2) @default(0) // calculado, persistido

  eventDate     DateTime   // fecha/hora del evento
  settledAt     DateTime?  // cuándo se resolvió (ganada/perdida/anulada)

  notes         String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, eventDate])
  @@index([sportsbookId])
  @@index([sportId])
  @@map("bets")
}

model BankrollTransaction {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      BankrollTxType
  amount    Decimal        @db.Decimal(12, 2) // siempre positivo; el signo lo da 'type'
  currency  String         @default("MXN")
  note      String?
  date      DateTime       @default(now())

  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([userId, date])
  @@map("bankroll_transactions")
}

// Juego responsable: límites configurables por el usuario.
model UserLimits {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyStakeLimit       Decimal? @db.Decimal(12, 2)
  weeklyStakeLimit      Decimal? @db.Decimal(12, 2)
  monthlyStakeLimit     Decimal? @db.Decimal(12, 2)
  maxBetsPerDay         Int?
  lossLimitAlert        Decimal? @db.Decimal(12, 2) // avisa si pérdidas acumuladas del período superan esto

  updatedAt             DateTime @updatedAt

  @@map("user_limits")
}
